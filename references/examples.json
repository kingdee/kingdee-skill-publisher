      "generated_skill": {
        "name": "pm-purchase-order-query",
        "description": "查询采购订单详情",
        "usage": {
          "python": "from scripts.api_call import call_kingdee_api\n\nresult = call_kingdee_api(\n    api_code='pm_getPurchaseOrderDetail',\n    params={\n        'orderId': '789012',\n        'includeDetails': True,\n        'includeReceiving': True\n    }\n)\n\nif result['success']:\n    order = result['data']\n    print(f\"订单号: {order['orderNo']}\")\n    print(f\"供应商: {order['supplierName']}\")\n    print(f\"订单状态: {order['status']}\")\n    print(f\"总金额: {order['totalAmount']}\")\n    \n    # 处理分录\n    for detail in order.get('details', []):\n        print(f\"  - {detail['materialName']}: {detail['qty']} {detail['unit']}\")\nelse:\n    print(f\"查询失败: {result['error_msg']}\")"
        }
      }
    },

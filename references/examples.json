  "configuration_templates": {
    "env_file": {
      "description": ".env文件模板",
      "content": "# 金蝶云苍穹API配置\n# 复制此文件为 .env，填入实际值\n\n# 服务器配置\nKINGDEE_SERVER_URL=https://xxx.kingdee.com:ierp\nKINGDEE_ACCOUNT_ID=your_account_id\nKINGDEE_USER=admin\n\n# 应用凭证（从开放平台获取）\nKINGDEE_APP_ID=your_app_id\nKINGDEE_APP_SECRET=your_app_secret\n\n# 可选：代理配置（如果需要）\n# HTTP_PROXY=http://proxy.example.com:8080\n# HTTPS_PROXY=https://proxy.example.com:8080\n\n# 可选：日志级别\n# LOG_LEVEL=INFO\n"
    },
    "docker_compose": {
      "description": "Docker Compose配置示例",
      "content": "version: '3.8'\n\nservices:\n  kingdee-skill-publisher:\n    image: python:3.9-slim\n    volumes:\n      - ./kingdee-skill-publisher:/app\n    environment:\n      - KINGDEE_SERVER_URL=${KINGDEE_SERVER_URL}\n      - KINGDEE_APP_ID=${KINGDEE_APP_ID}\n      - KINGDEE_APP_SECRET=${KINGDEE_APP_SECRET}\n      - KINGDEE_ACCOUNT_ID=${KINGDEE_ACCOUNT_ID}\n      - KINGDEE_USER=${KINGDEE_USER:-admin}\n    working_dir: /app\n    command: python -m scripts\n    ports:\n      - \"8080:8080\"\n"
    },
    "requirements_txt": {
      "description": "Python依赖",
      "content": "requests>=2.28.0\njson5>=0.9.0\npython-dotenv>=0.20.0\nPyYAML>=6.0\n"
    }
  }

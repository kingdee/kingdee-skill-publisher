{
  "examples": {
    "financial_bill_query": {
      "description": "财务凭证查询Skill示例",
      "api_info": {
        "api_code": "ar_getBillDetail",
        "api_name": "应收凭证详情查询",
        "api_description": "查询应收凭证的详细信息，包括基本信息、分录、附件等",
        "method": "GET",
        "form_id": "ar_bill",
        "module": "应收模块",
        "version": "5.0.0+",
        "status": "published",
        "request_params": [
          {
            "name": "billId",
            "type": "String",
            "required": true,
            "description": "凭证ID"
          },
          {
            "name": "expandEntries",
            "type": "Boolean",
            "required": false,
            "default": false,
            "description": "是否展开分录数据"
          }
        ],
        "return_params": [
          {
            "name": "id",
            "type": "String",
            "description": "凭证ID"
          },
          {
            "name": "billNo",
            "type": "String",
            "description": "凭证编号"
          },
          {
            "name": "customerName",
            "type": "String",
            "description": "客户名称"
          },
          {
            "name": "amount",
            "type": "Decimal",
            "description": "凭证金额"
          },
          {
            "name": "status",
            "type": "String",
            "description": "凭证状态（DRAFT/ISSUED/CONFIRMED/CANCELED）"
          },
          {
            "name": "entries",
            "type": "Array",
            "description": "分录列表（当expandEntries为true时返回）"
          }
        ],
        "error_codes": {
          "602": {
            "name": "BILL_NOT_FOUND",
            "description": "凭证不存在"
          },
          "403": {
            "name": "NO_PERMISSION",
            "description": "无权限查看此凭证"
          }
        }
      },
      "generated_skill": {
        "name": "ar-bill-detail-query",
        "description": "查询应收凭证详情",
        "usage": {
          "python": "from scripts.api_call import call_kingdee_api\n\nresult = call_kingdee_api(\n    api_code='ar_getBillDetail',\n    params={\n        'billId': '123456',\n        'expandEntries': True\n    }\n)\n\nif result['success']:\n    bill = result['data']\n    print(f\"凭证号: {bill['billNo']}\")\n    print(f\"客户: {bill['customerName']}\")\n    print(f\"金额: {bill['amount']}\")\nelse:\n    print(f\"查询失败: {result['error_msg']}\")"
        }
      }
    },
